{
  "name": "staffsync-hrms",
  "version": "1.0.0",
  "description": "StaffSync - Modern Human Resource Management Solution (MERN Stack)",
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm start --prefix server",
    "client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "build": "npm run build --prefix client"
  },
  "keywords": [
    "mern",
    "hrms",
    "human-resources",
    "staffsync",
    "mongodb",
    "express",
    "react",
    "nodejs"
  ],
  "author": "StaffSync Team",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
